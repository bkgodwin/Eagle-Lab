# Copy to .env for start.sh. Do not commit credentials or private keys.
HOST=0.0.0.0
PORT=3000
PROXY_PORT_START=8100
PROXY_PORT_END=8199
STATUS_INTERVAL_MS=5000
STATUS_TIMEOUT_MS=5000
# Browser-accessible full lab address displayed by the read-only EagleIDE tool.
# PUBLIC_URL=http://eagle-lab.lan:3000/
# AUTO_SETUP creates a one-time bootstrap token if no admin exists.
# The token appears in the console/journal and data/setup-token.txt.
# TLS_CERT=/opt/eagle-lab/certs/lab-cert.pem
# TLS_KEY=/opt/eagle-lab/certs/lab-key.pem
